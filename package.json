{
  "name": "school-management",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "concurrently -k \"npm run start:frontend\" \"npm run start:backend\" \"npm run start:ws\" \"npm run start:electron\"",
    "start:electron": "electron .",
    "dev": "concurrently -k \"npm run dev:frontend\" \"npm run dev:backend\" \"npm run dev:ws\"",
    "dev:frontend": "vite",
    "dev:backend": "php -S 127.0.0.1:8000 -t backend",
    "dev:ws": "npm --prefix backend-ws start",
    "build": "vite build",
    "lint": "eslint .",
    "check": "npm run lint && npm run build",
    "preview": "vite preview",
    "start:backend": "php -S 127.0.0.1:8000 -t backend",
    "start:ws": "npm --prefix backend-ws start",
    "migrate": "php backend/migrate.php",
    "create:admin": "php backend/create-admin.php",
    "start:frontend": "vite --host",
    "precommit:check": "node scripts/precommit-check.mjs"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.14",
    "baseline-browser-mapping": "^2.11.10",
    "concurrently": "^8.2.2",
    "electron": "^43.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.0",
    "vite": "^8.2.0"
  }
}
