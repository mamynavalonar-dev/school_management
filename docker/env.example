# Exemple uniquement — ne mettez jamais de vrais secrets dans Git.
# En local, le script crée automatiquement .env.docker.local avec des valeurs aléatoires.

MYSQL_DATABASE=school_management
MYSQL_USER=school_user
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

DB_NAME=school_management
DB_USER=school_user
DB_PASSWORD=CHANGE_ME

REALTIME_INTERNAL_SECRET=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# MySQL TLS (Aiven / production)
# Laisser DB_SSL_CA vide pour le MySQL local sans TLS.
DB_SSL_CA=
DB_SSL_VERIFY=true

# Démo portfolio : réveil automatique Aiven (token serveur uniquement).
AIVEN_AUTO_WAKE=false
AIVEN_API_TOKEN=
AIVEN_PROJECT=
AIVEN_SERVICE=

# Démonstration portfolio publique (aucun mot de passe public)
PUBLIC_DEMO_ENABLED=false
PUBLIC_DEMO_USERNAME=portfolio-demo
PUBLIC_DEMO_NAME=Visiteur Démo
PUBLIC_DEMO_EMAIL=portfolio-demo@example.invalid
