<?php
/**
 * Authentication guard middleware.
 * Ensures the user is logged in by checking $_SESSION['user_id'].
 * If not authenticated, returns a 401 JSON response and exits.
 */
session_start(); // Ensure session is started
error_log("SESSION DEBUG: session_id() = " . session_id());
error_log("SESSION DEBUG: _SESSION contents = " . print_r($_SESSION, true));

if (empty($_SESSION['user_id'])) {
    http_response_code(401);
    header('Content-Type: application/json; charset=UTF-8');
    echo json_encode([
        'success' => false,
        'message' => 'Non authentifié'
    ]);
    exit();
}