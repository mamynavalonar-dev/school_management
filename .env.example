# Configuration locale de school_management
# Copiez ce fichier en .env puis remplacez les valeurs sensibles.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=school_management
DB_USER=root
DB_PASSWORD=

# Origines autorisées en développement.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null

# Temps réel / WebSocket
WS_PORT=3001
WS_DEBUG=false
# OBLIGATOIRE : remplacez cette valeur par un secret aléatoire d'au moins 32 caractères.
REALTIME_INTERNAL_SECRET=CHANGE_ME_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
REALTIME_INTERNAL_URL=http://127.0.0.1:3001/internal/notify

# Frontend Vite. /api convient au navigateur ; Electron file:// est géré par api.js.
VITE_API_BASE_URL=/api
# Laissez VITE_WS_URL vide pour dériver automatiquement l'hôte courant.
VITE_WS_URL=

# WebRTC (facultatif)
# VITE_STUN_URL=stun:stun.l.google.com:19302
# VITE_TURN_URL=
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=

# Création initiale d'un administrateur (facultatif selon votre procédure)
# INITIAL_ADMIN_NAME=Administrateur
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_EMAIL=admin@example.test
# INITIAL_ADMIN_PASSWORD=CHANGE_ME

# MySQL TLS (Aiven / production)
# Laisser DB_SSL_CA vide pour le MySQL local sans TLS.
DB_SSL_CA=
DB_SSL_VERIFY=true

# Démo portfolio : réveil automatique Aiven (token serveur uniquement).
AIVEN_AUTO_WAKE=false
AIVEN_API_TOKEN=
AIVEN_PROJECT=
AIVEN_SERVICE=

# Démonstration portfolio publique (aucun mot de passe public)
PUBLIC_DEMO_ENABLED=false
PUBLIC_DEMO_USERNAME=portfolio-demo
PUBLIC_DEMO_NAME=Visiteur Démo
PUBLIC_DEMO_EMAIL=portfolio-demo@example.invalid
